NETBRAIN_BASE_URL=https://netbrain-prod.bank.intranet/ServicesAPI/API
NETBRAIN_TOKEN=
NETBRAIN_VERIFY_SSL=true
# Rows per page. Use 0 to get everything in one call (fails on very large tables)
NETBRAIN_PAGE_SIZE=100000
# The doc example paginates from pageIndex=1; set 0 if the API is 0-based
NETBRAIN_FIRST_PAGE_INDEX=1
INPUT_XLSX=devices.xlsx
OUTPUT_DIR=output
